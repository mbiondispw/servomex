    <description>Servomex Quote Agent (#57): creates a Service Upsell opportunity on an account at Proposal/Quote with the Standard Price Book and Next Step "Send services quote". Name defaults to "Account Name — Services — YYYY-MM-DD", close date to today + 30 and currency to the account's currency; each input overrides its default.</description>
    <environments>Default</environments>
    <formulas>
        <name>resolvedCloseDate</name>
        <dataType>Date</dataType>
        <expression>IF(ISBLANK({!closeDate}), {!$Flow.CurrentDate} + 30, DATEVALUE({!closeDate}))</expression>
    </formulas>
    <formulas>
        <name>resolvedCurrencyIsoCode</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!currencyIsoCode}), TEXT({!Get_Account.CurrencyIsoCode}), UPPER({!currencyIsoCode}))</expression>
    </formulas>
    <formulas>
        <name>resolvedOpportunityName</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!opportunityName}), {!Get_Account.Name} &amp; &quot; — Services — &quot; &amp; TEXT({!$Flow.CurrentDate}), {!opportunityName})</expression>
    </formulas>
    <interviewLabel>SMX Create Opportunity {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SMX Create Opportunity</label>
