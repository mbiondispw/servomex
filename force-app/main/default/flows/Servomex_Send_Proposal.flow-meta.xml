    <description>Send Proposal: checks the Quote (not Accepted/Denied, has a Quote Contact with a Demo Inbox Address), generates the Proposal PDF with rlm-base-dev docgen, emails it to the Quote Contact from the running user with the Servomex_Proposal template, logs the email, and sets Status to Presented. See docs/features/send-proposal.md.</description>
    <dynamicChoiceSets>
        <name>ActiveQuoteTemplates</name>
        <dataType>String</dataType>
        <displayField>Name</displayField>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>UsageType</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Revenue_Lifecycle_Management</stringValue>
            </value>
        </filters>
        <object>DocumentTemplate</object>
        <sortField>Name</sortField>
        <sortOrder>Asc</sortOrder>
        <valueField>Name</valueField>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <formulas>
        <description>Proposal file title: Quote Number plus the send date and UTC time, so each send is told apart.</description>
        <name>forProposalTitle</name>
        <dataType>String</dataType>
        <expression>'Proposal ' &amp; {!Get_Quote.QuoteNumber} &amp; ' ' &amp; TEXT({!$Flow.CurrentDate}) &amp; ' ' &amp; MID(TEXT({!$Flow.CurrentDateTime}), 12, 5) &amp; ' UTC'</expression>
    </formulas>
    <interviewLabel>Send Proposal {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Send Proposal</label>
